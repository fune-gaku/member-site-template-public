# 公開先 URL (Astro の site / @astrojs/sitemap が必須)
PUBLIC_SITE_URL=https://example.com

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Cloudflare Turnstile (任意・opt-in / デフォルト OFF)
# 有効化するには 3 層を揃える:
#   1. supabase/config.toml で [auth.captcha].enabled = true
#   2. 本番: Supabase Dashboard > Auth > Bot and Abuse Protection で Turnstile + Secret Key を登録
#   3. 下記 2 行をアンコメントして site key / secret を設定（PUBLIC_ は build 時 inline、secret は supabase start が config.toml の env() で解決）
# Cloudflare 公式の常時 pass テストキー (任意ドメイン可、本番では実キーに差し替え):
#   https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google OAuth ログインを有効化（任意、opt-in）
# Issue #49 で進行中: PR 1 はドキュメント先行のみで、auth.signInWithGoogle Action と
# signin/signup の Google ボタンは PR 2 / PR 3 マージ後に有効化される。PR 1 単体で
# `true` にしても下記の挙動は再現しない（src/ にまだ実装が無いため）。
# デフォルト OFF — PR 2/3 マージ後に true にすると signin/signup に Google ボタン表示
# + auth.signInWithGoogle Action 受付。
# 有効化前に Google Cloud Console + Supabase Dashboard > Auth > Providers > Google の設定が必要。
# 詳細: .claude/deployment.md「Google OAuth セットアップ（任意）」
PUBLIC_GOOGLE_AUTH_ENABLED=false
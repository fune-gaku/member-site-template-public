PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Cloudflare Turnstile (任意・opt-in、両方設定すれば 3 経路 (signin / signup / resetPassword) で CAPTCHA 有効)
# Cloudflare 公式の localhost / CI 用テストキー (常時 pass、任意ドメイン可)
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# 本番では Cloudflare Dashboard で発行した実キーに置き換え、Secret Key は
# Supabase Dashboard > Auth > Bot and Abuse Protection に登録する (Workers secret 不要)。
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Issue #52: Supabase CLI が `supabase/config.toml` の `[auth.captcha]` の
# `env(TURNSTILE_SECRET_KEY)` を解決する際にこの .env を読む (公式 Managing Config 仕様)。
# `supabase start` でローカル Auth コンテナが Turnstile を検証できるようにする。
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

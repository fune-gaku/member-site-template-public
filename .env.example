# Supabase Configuration
# クライアントサイドで使用する環境変数（PUBLIC_ プレフィックス必須）

# Supabase Project URL
# 取得方法: Supabase Dashboard > Settings > API > Project URL
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key (anon key)
# 取得方法: Supabase Dashboard > Settings > API > Project API keys > anon public
PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

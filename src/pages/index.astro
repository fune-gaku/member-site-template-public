---
import Base from "../layouts/Base.astro";

// このページはテンプレ利用者が自プロダクトの LP に差し替える前提。最上部に
// 常設バナーを置く意図はそのまま (毎回出すことに意味がある)。
const REPO_URL = "https://github.com/fune-gaku/member-site-template-public";
const README_URL = `${REPO_URL}/blob/main/README.md`;
const USE_TEMPLATE_URL = `${REPO_URL}/generate`;
---

<Base
  title="会員サイトテンプレート"
  description="Astro 6 + Vue 3 + Supabase + Cloudflare Workers の会員サイトテンプレート。"
>
  <!-- ① Template Notice Banner (常設) -->
  <aside
    role="note"
    aria-label="テンプレート利用者向けの注意"
    class="border-b border-amber-300 bg-amber-50 text-amber-900"
  >
    <div
      class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-3 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
    >
      <p>
        <span aria-hidden="true">⚠️</span>
        このランディングページは <strong>テンプレート紹介用</strong> です。 あなたのプロダクトに合わせて
        <code
          class="rounded bg-amber-100 px-1.5 py-0.5 font-mono text-xs text-amber-900"
          >src/pages/index.astro</code
        > を置き換えてください。
      </p>
      <a
        href={README_URL}
        class="shrink-0 font-semibold underline hover:no-underline"
      >
        README を読む &rarr;
      </a>
    </div>
  </aside>

  <!-- ② タイトル + 一行 -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-gray-900 md:text-4xl">
        会員サイトテンプレート
      </h1>
      <p class="mt-4 text-lg text-gray-700">
        Astro 6 + Vue 3 + Supabase + Cloudflare Workers
        の会員サイトテンプレート。Claude Code
        前提のプロジェクト規約と運用ルールを <code
          class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-base"
          >.claude/</code
        > 配下に同梱。
      </p>
    </div>
  </section>

  <!-- ③ 機能 -->
  <section class="border-t border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-gray-900 md:text-3xl">機能</h2>
      <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <li class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="mb-2 text-lg font-semibold text-gray-900">RLS</h3>
          <p class="text-sm text-gray-700">
            全テーブルで RLS 有効化。<code
              class="rounded bg-gray-100 px-1 py-0.5 font-mono text-xs"
              >profiles.role</code
            > は table-level UPDATE 剥奪 + column-level 再付与。pgTAP で退行検知。
          </p>
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="mb-2 text-lg font-semibold text-gray-900">CSRF</h3>
          <p class="text-sm text-gray-700">
            Astro <code
              class="rounded bg-gray-100 px-1 py-0.5 font-mono text-xs"
              >security.checkOrigin</code
            > + 状態変更は POST 限定。GET 405 / クロスオリジン POST 403 を実 workerd
            ランタイムで自動テスト。
          </p>
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="mb-2 text-lg font-semibold text-gray-900">
            Google OAuth (opt-in)
          </h3>
          <p class="text-sm text-gray-700">
            <code class="rounded bg-gray-100 px-1 py-0.5 font-mono text-xs"
              >PUBLIC_GOOGLE_AUTH_ENABLED</code
            > 未設定でデフォルト OFF。env と Supabase Dashboard を揃えたときだけ有効化。
          </p>
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="mb-2 text-lg font-semibold text-gray-900">
            Codex × Claude Code レビュー
          </h3>
          <p class="text-sm text-gray-700">
            <code class="rounded bg-gray-100 px-1 py-0.5 font-mono text-xs"
              >/codex-cross-review &lt;PR&gt;</code
            > で OpenAI Codex と Claude Code が双方 LGTM するまで反復。
          </p>
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="mb-2 text-lg font-semibold text-gray-900">
            DB マイグレーションの 7 ステップ + pgTAP
          </h3>
          <p class="text-sm text-gray-700">
            <code class="rounded bg-gray-100 px-1 py-0.5 font-mono text-xs"
              >supabase migration new</code
            > → <code class="rounded bg-gray-100 px-1 py-0.5 font-mono text-xs"
              >/db-check</code
            > → dry-run → cross-review。RLS / トリガー / 列レベル grant は pgTAP で検証。
          </p>
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-5">
          <h3 class="mb-2 text-lg font-semibold text-gray-900">
            Cloudflare Workers
          </h3>
          <p class="text-sm text-gray-700">
            SSR を Cloudflare Workers で配信。<code
              class="rounded bg-gray-100 px-1 py-0.5 font-mono text-xs"
              >wrangler secret put</code
            > で per-Worker secret 管理、<code
              class="rounded bg-gray-100 px-1 py-0.5 font-mono text-xs"
              >SUPABASE_SERVICE_ROLE_KEY</code
            > はサーバー側のみ。
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ④ 技術スタック -->
  <section class="border-t border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-gray-900 md:text-3xl">
        技術スタック
      </h2>
      <ul
        class="grid grid-cols-2 gap-3 text-sm font-medium text-gray-900 sm:grid-cols-3 lg:grid-cols-6"
      >
        <li class="rounded-lg border border-gray-200 bg-white p-4 text-center">
          Astro 6
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-4 text-center">
          Vue 3
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-4 text-center">
          Supabase
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-4 text-center">
          Cloudflare Workers
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-4 text-center">
          Tailwind CSS 4
        </li>
        <li class="rounded-lg border border-gray-200 bg-white p-4 text-center">
          Vitest 4
        </li>
      </ul>
    </div>
  </section>

  <!-- ⑤ デモ / README / GitHub へのリンク -->
  <section class="border-t border-gray-200 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="mb-8 text-2xl font-bold text-gray-900 md:text-3xl">リンク</h2>
      <ul class="space-y-3 text-base">
        <li>
          <a href={USE_TEMPLATE_URL} class="text-brand-700 hover:underline"
            >Use this template</a
          >
          <span class="text-gray-600">
            — このリポジトリをテンプレートにして自分のリポジトリを作る</span
          >
        </li>
        <li>
          <a href={README_URL} class="text-brand-700 hover:underline">README</a>
          <span class="text-gray-600"> — セットアップ・本番デプロイ手順</span>
        </li>
        <li>
          <a href={REPO_URL} class="text-brand-700 hover:underline">GitHub</a>
          <span class="text-gray-600"> — ソースコードと Issues</span>
        </li>
        <li>
          <a href="/auth/signup" class="text-brand-700 hover:underline"
            >サインアップ</a
          >
          <span class="text-gray-600"> — 動くデモのアカウント作成</span>
        </li>
        <li>
          <a href="/auth/signin" class="text-brand-700 hover:underline"
            >サインイン</a
          >
          <span class="text-gray-600"> — 既存アカウントでログイン</span>
        </li>
      </ul>
    </div>
  </section>

  <footer class="border-t border-gray-200 bg-white py-8">
    <div class="mx-auto max-w-7xl px-4 text-sm text-gray-600 sm:px-6 lg:px-8">
      <p>&copy; 2026 member-site-template. MIT License.</p>
    </div>
  </footer>
</Base>

---
import Member from "../../layouts/Member.astro";
import ProfileForm from "../../components/ProfileForm.vue";
---

<Member title="プロフィール" description="プロフィール設定">
  <div class="space-y-8">
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-2">プロフィール設定</h2>
      <p class="text-gray-600">
        アカウント情報とプロフィール画像を管理できます。
      </p>
    </div>

    <ProfileForm client:load />
  </div>
</Member>

---
import { actions } from "astro:actions";

import ChangePasswordForm from "../../components/ChangePasswordForm.vue";
import ProfileForm from "../../components/ProfileForm.vue";
import Member from "../../layouts/Member.astro";
import { logger } from "../../lib/logger";
import { createClient } from "../../lib/supabase";

// Issue #34: signOut Action 成功後の redirect は page-level で行う必要がある
// （Astro 公式: layout / 子コンポーネントからの Astro.redirect は無効）。
// ここを抜けると cookie が消えた状態で SSR を続けてしまうため frontmatter 冒頭で短絡させる。
const signOutResult = Astro.getActionResult(actions.auth.signOut);
if (signOutResult && !signOutResult.error) {
  return Astro.redirect("/");
}

const user = Astro.locals.user;
let initialDisplayName = "";
let initialAvatarUrl = "";

// Issue #49: ChangePasswordForm は email/password identity を持つユーザーのみに表示する。
// Google OAuth のみで signup したユーザーには変更すべきパスワードが存在しないため、
// UI を出さない方が誠実（出してもサーバ側 `auth.changePassword` が現パスワード検証で
// 必ず失敗するが、UX として無意味なフォームを見せない）。
//
// 判定は `auth.getUser()` の identities 配列を見る。middleware は `getClaims()` で
// 軽量検証する設計のため、identities が必要な箇所だけ明示的に full user を取得する。
// fail-open: identities が未取得 / undefined のときはフォーム表示（既存 email/password
// 利用者を transient API 障害で締め出さない）。
let hasEmailIdentity = true;

if (user) {
  const supabase = createClient({
    request: Astro.request,
    cookies: Astro.cookies,
  });

  const { data: profile, error: profileError } = await supabase
    .from("profiles")
    .select("display_name, avatar_url")
    .eq("user_id", user.id)
    .single();

  if (profileError) {
    logger.error("Profile SSR load error", profileError);
  } else if (profile) {
    initialDisplayName = profile.display_name ?? "";
    if (profile.avatar_url) {
      const { data: urlData, error: urlError } = await supabase.storage
        .from("avatars")
        .createSignedUrl(profile.avatar_url, 3600);
      if (urlError) {
        logger.error("Signed URL SSR error", urlError);
      } else if (urlData) {
        initialAvatarUrl = urlData.signedUrl;
      }
    }
  }

  // identities を取得して email provider の有無を判定。
  const { data: fullUser, error: userError } = await supabase.auth.getUser();
  if (userError) {
    logger.error("Profile SSR getUser error", userError);
  } else if (Array.isArray(fullUser.user?.identities)) {
    hasEmailIdentity = fullUser.user.identities.some(
      (i) => i.provider === "email",
    );
  }
}
---

<Member title="プロフィール" description="プロフィール設定">
  <div class="space-y-8">
    <div>
      <h2 class="mb-2 text-2xl font-bold text-gray-900">プロフィール設定</h2>
      <p class="text-gray-600">
        アカウント情報とプロフィール画像を管理できます。
      </p>
    </div>

    <ProfileForm
      client:load
      initialDisplayName={initialDisplayName}
      initialAvatarUrl={initialAvatarUrl}
    />

    {hasEmailIdentity && <ChangePasswordForm client:load />}
  </div>
</Member>

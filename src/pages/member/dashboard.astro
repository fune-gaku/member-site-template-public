---
import Member from "../../layouts/Member.astro";

const user = Astro.locals.user;
const profile = Astro.locals.profile;
const isAdmin = profile?.role === "admin";
---

<Member title="ダッシュボード" description="会員ダッシュボード">
  <div class="space-y-8">
    <!-- Welcome Card -->
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="mb-2 text-2xl font-bold text-gray-900">
        ようこそ、{user?.email ?? "ゲスト"}さん
      </h2>
      <p class="text-gray-600">
        会員サイトへようこそ。下のクイックアクションから各機能にアクセスできます。
      </p>
    </div>

    <!-- Quick Actions -->
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <h3 class="mb-4 text-lg font-semibold text-gray-900">
        クイックアクション
      </h3>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <a
          href="/member/profile"
          class="flex items-center rounded-lg border border-gray-200 p-4 transition hover:bg-gray-50"
        >
          <div
            class="bg-brand-100 mr-3 flex h-10 w-10 items-center justify-center rounded-lg"
          >
            <svg
              class="text-brand-600 h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
          </div>
          <div>
            <div class="font-medium text-gray-900">プロフィール編集</div>
            <div class="text-sm text-gray-600">表示名・アバターを更新</div>
          </div>
        </a>

        <a
          href="/member/data"
          class="flex items-center rounded-lg border border-gray-200 p-4 transition hover:bg-gray-50"
        >
          <div
            class="bg-brand-100 mr-3 flex h-10 w-10 items-center justify-center rounded-lg"
          >
            <svg
              class="text-brand-600 h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </div>
          <div>
            <div class="font-medium text-gray-900">データ</div>
            <div class="text-sm text-gray-600">投稿の作成・編集・削除</div>
          </div>
        </a>

        {
          isAdmin && (
            <a
              href="/admin/users"
              class="flex items-center rounded-lg border border-red-200 bg-red-50 p-4 transition hover:bg-red-100"
            >
              <div class="mr-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-100">
                <svg
                  class="h-5 w-5 text-red-700"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                  />
                </svg>
              </div>
              <div>
                <div class="font-medium text-red-900">管理画面</div>
                <div class="text-sm text-red-700">ユーザー管理・招待</div>
              </div>
            </a>
          )
        }

        <a
          href="/auth/signout"
          class="flex items-center rounded-lg border border-gray-200 p-4 transition hover:bg-gray-50"
        >
          <div
            class="mr-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-100"
          >
            <svg
              class="h-5 w-5 text-red-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
              ></path>
            </svg>
          </div>
          <div>
            <div class="font-medium text-gray-900">サインアウト</div>
            <div class="text-sm text-gray-600">ログアウト</div>
          </div>
        </a>
      </div>
    </div>
  </div>
</Member>

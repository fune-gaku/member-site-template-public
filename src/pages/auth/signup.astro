---
import { actions } from "astro:actions";

import SignupForm from "../../components/SignupForm.vue";
import Auth from "../../layouts/Auth.astro";

// Google OAuth 有効化フラグ（Issue #49）。signin.astro と同じ多層防御パターン。
const googleAuthEnabled = import.meta.env.PUBLIC_GOOGLE_AUTH_ENABLED === "true";

const googleResult = googleAuthEnabled
  ? Astro.getActionResult(actions.auth.signInWithGoogle)
  : undefined;
if (googleResult?.data?.url) {
  return Astro.redirect(googleResult.data.url);
}
const googleErrorMessage = googleResult?.error?.message;
---

<Auth
  title="新規登録"
  description="アカウントを作成して始めましょう"
  enableTurnstile
>
  <SignupForm client:load />

  {
    googleAuthEnabled && (
      <>
        <div
          class="my-6 flex items-center gap-3 text-xs text-gray-500"
          aria-hidden="true"
        >
          <span class="h-px flex-1 bg-gray-200" />
          <span>または</span>
          <span class="h-px flex-1 bg-gray-200" />
        </div>

        {googleErrorMessage && (
          <div class="mb-3 rounded-lg border border-red-200 bg-red-50 p-3">
            <p class="text-sm text-red-800" role="alert">
              {googleErrorMessage}
            </p>
          </div>
        )}

        <form method="POST" action={actions.auth.signInWithGoogle}>
          <button
            type="submit"
            class="focus-visible:ring-brand-200 flex w-full items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-3 font-medium text-gray-700 transition hover:bg-gray-50 focus-visible:ring-4 focus-visible:outline-none"
          >
            Google で新規登録
          </button>
        </form>
      </>
    )
  }
</Auth>

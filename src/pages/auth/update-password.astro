---
/**
 * Issue #002-B: パスワードリセット / 招待直後の新パスワード設定画面。
 *
 * `/auth/confirm` の POST で `verifyOtp({ type: "recovery" | "invite" })` を成功させ、
 * recovery セッションを確立した状態から遷移してくる。
 * recovery セッション無しでの直接アクセスは `/auth/signin?error=recovery_session_required`
 * にリダイレクトする。
 */
import UpdatePasswordForm from "../../components/UpdatePasswordForm.vue";
import Auth from "../../layouts/Auth.astro";
import { getAuthUser } from "../../lib/auth-claims";
import { createClient } from "../../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const user = await getAuthUser(supabase);

if (!user) {
  return Astro.redirect("/auth/signin?error=recovery_session_required");
}

const mode = Astro.url.searchParams.get("mode");
const isInvite = mode === "invite";
const title = isInvite ? "パスワードを設定" : "新しいパスワードを設定";
const description = isInvite
  ? "ようこそ。初回ログイン用のパスワードを設定してください"
  : "リセットを確定するため、新しいパスワードを入力してください";
---

<Auth title={title} description={description}>
  <UpdatePasswordForm client:load />
</Auth>

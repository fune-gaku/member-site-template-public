---
import { actions } from "astro:actions";
import Auth from "../../layouts/Auth.astro";

let success = false;
let error = "";

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get("email");

    if (typeof email === "string") {
      const result = await actions.auth.resetPassword({ email });
      if (result.error) {
        error = result.error.message;
      } else {
        success = true;
      }
    }
  } catch (e) {
    error = "予期しないエラーが発生しました";
  }
}
---

<Auth title="パスワードリセット" description="登録済みのメールアドレスを入力してください">
  {success ? (
    <div class="p-4 bg-green-50 border border-green-200 rounded-lg">
      <p class="text-sm text-green-800">
        パスワードリセット用のメールを送信しました。メール内のリンクをクリックしてパスワードを再設定してください。
      </p>
      <div class="mt-4 text-center">
        <a href="/auth/signin" class="text-sm text-brand-600 hover:text-brand-700 font-medium">
          サインインに戻る
        </a>
      </div>
    </div>
  ) : (
    <form method="POST" class="space-y-6">
      {error && (
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
          <p class="text-sm text-red-800">{error}</p>
        </div>
      )}

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
          メールアドレス
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
          placeholder="you@example.com"
        />
      </div>

      <button
        type="submit"
        class="w-full px-4 py-3 text-white bg-brand-600 rounded-lg font-medium hover:bg-brand-700 focus:ring-4 focus:ring-brand-200 transition"
      >
        リセットメールを送信
      </button>

      <div class="text-center text-sm text-gray-600">
        <a href="/auth/signin" class="text-brand-600 hover:text-brand-700 font-medium">
          サインインに戻る
        </a>
      </div>
    </form>
  )}
</Auth>

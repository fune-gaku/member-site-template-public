---
import AdminUsersPanel from "../../components/AdminUsersPanel.vue";
import Admin from "../../layouts/Admin.astro";

// middleware で /admin/* は未認証・非 admin をリダイレクト済み
const user = Astro.locals.user;
---

<Admin title="ユーザー管理" description="ユーザー一覧・招待・ロール変更">
  <div class="space-y-8">
    <div>
      <h2 class="mb-2 text-2xl font-bold text-gray-900">ユーザー管理</h2>
      <p class="text-gray-600">
        登録済みユーザーの一覧・新規招待・ロールの変更を行えます。
      </p>
    </div>

    {user && <AdminUsersPanel client:load currentUserId={user.id} />}
  </div>
</Admin>

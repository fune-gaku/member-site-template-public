---
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
  enableTurnstile?: boolean;
}

const { title, description, enableTurnstile = false } = Astro.props;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const injectTurnstileLoader = enableTurnstile && Boolean(turnstileSiteKey);
---

<Base title={title} description={description} noIndex>
  {
    injectTurnstileLoader && (
      <Fragment slot="head">
        <link rel="preconnect" href="https://challenges.cloudflare.com" />
        <script
          src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileReady"
          defer
          data-turnstile-loader="true"
          is:inline
        />
      </Fragment>
    )
  }
  <div
    class="from-brand-50 to-brand-100 flex min-h-screen items-center justify-center bg-gradient-to-br px-4 py-12"
  >
    <div class="w-full max-w-md">
      <div class="rounded-xl bg-white p-8 shadow-xl">
        <div class="mb-8 text-center">
          <h1 class="mb-2 text-3xl font-bold text-gray-900">{title}</h1>
          {description && <p class="text-gray-600">{description}</p>}
        </div>
        <slot />
      </div>
      <div class="mt-6 text-center">
        <a
          href="/"
          class="text-brand-600 hover:text-brand-700 text-sm transition-colors"
        >
          トップページに戻る
        </a>
      </div>
    </div>
  </div>
</Base>

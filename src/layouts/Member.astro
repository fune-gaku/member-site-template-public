---
import { actions } from "astro:actions";

import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const user = Astro.locals.user;
const profile = Astro.locals.profile;
const isAdmin = profile?.role === "admin";
const currentPath = Astro.url.pathname;

// Issue #005: サインアウトはフォーム POST のみで副作用を起こす。
// GET を 405 にするため、ヘッダのフォームも method="POST" + Astro Action に差し替え。
const signOutResult = Astro.getActionResult(actions.auth.signOut);
if (signOutResult && !signOutResult.error) {
  return Astro.redirect("/");
}
---

<Base title={title} description={description}>
  <div class="flex min-h-screen flex-col">
    <!-- Header -->
    <header class="sticky top-0 z-10 border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <!-- Logo / Brand -->
          <div class="flex items-center">
            <a
              href="/member/dashboard"
              class="text-brand-600 text-xl font-bold"
            >
              会員サイト
            </a>
          </div>

          <!-- Navigation -->
          <nav class="hidden space-x-8 md:flex">
            <a
              href="/member/dashboard"
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                currentPath === "/member/dashboard"
                  ? "bg-brand-100 text-brand-700"
                  : "text-gray-700 hover:bg-gray-100",
              ]}
            >
              ダッシュボード
            </a>
            <a
              href="/member/profile"
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                currentPath === "/member/profile"
                  ? "bg-brand-100 text-brand-700"
                  : "text-gray-700 hover:bg-gray-100",
              ]}
            >
              プロフィール
            </a>
            <a
              href="/member/data"
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                currentPath === "/member/data"
                  ? "bg-brand-100 text-brand-700"
                  : "text-gray-700 hover:bg-gray-100",
              ]}
            >
              データ
            </a>
            {
              isAdmin && (
                <a
                  href="/admin/users"
                  class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700 transition-colors hover:bg-red-100"
                >
                  管理画面
                </a>
              )
            }
          </nav>

          <!-- User Menu -->
          <div class="flex items-center space-x-4">
            <span class="text-sm text-gray-700">
              {user?.email || "ゲスト"}
            </span>
            <form method="POST" action={actions.auth.signOut}>
              <button
                type="submit"
                class="bg-brand-600 hover:bg-brand-700 rounded-md px-4 py-2 text-sm font-medium text-white transition-colors"
              >
                サインアウト
              </button>
            </form>
          </div>
        </div>

        <!-- Mobile Navigation -->
        <nav class="space-y-1 pb-4 md:hidden">
          <a
            href="/member/dashboard"
            class:list={[
              "block rounded-md px-3 py-2 text-base font-medium transition-colors",
              currentPath === "/member/dashboard"
                ? "bg-brand-100 text-brand-700"
                : "text-gray-700 hover:bg-gray-100",
            ]}
          >
            ダッシュボード
          </a>
          <a
            href="/member/profile"
            class:list={[
              "block rounded-md px-3 py-2 text-base font-medium transition-colors",
              currentPath === "/member/profile"
                ? "bg-brand-100 text-brand-700"
                : "text-gray-700 hover:bg-gray-100",
            ]}
          >
            プロフィール
          </a>
          <a
            href="/member/data"
            class:list={[
              "block rounded-md px-3 py-2 text-base font-medium transition-colors",
              currentPath === "/member/data"
                ? "bg-brand-100 text-brand-700"
                : "text-gray-700 hover:bg-gray-100",
            ]}
          >
            データ
          </a>
          {
            isAdmin && (
              <a
                href="/admin/users"
                class="block rounded-md border border-red-200 bg-red-50 px-3 py-2 text-base font-medium text-red-700 transition-colors hover:bg-red-100"
              >
                管理画面
              </a>
            )
          }
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 bg-gray-50">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 bg-white py-6">
      <div
        class="mx-auto max-w-7xl px-4 text-center text-sm text-gray-600 sm:px-6 lg:px-8"
      >
        &copy; 2026 会員サイトテンプレート. All rights reserved.
      </div>
    </footer>
  </div>
</Base>

---
import { actions } from "astro:actions";

import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const user = Astro.locals.user;
const currentPath = Astro.url.pathname;

// Issue #005: サインアウトはフォーム POST のみで副作用を起こす。
const signOutResult = Astro.getActionResult(actions.auth.signOut);
if (signOutResult && !signOutResult.error) {
  return Astro.redirect("/");
}
---

<Base title={title} description={description}>
  <div class="flex min-h-screen flex-col">
    <!-- Header -->
    <header class="sticky top-0 z-10 border-b border-gray-200 bg-gray-900">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <!-- Logo / Brand -->
          <div class="flex items-center gap-3">
            <a href="/admin/users" class="text-xl font-bold text-white">
              管理画面
            </a>
            <span
              class="rounded bg-red-500/90 px-2 py-0.5 text-xs font-semibold text-white"
            >
              ADMIN
            </span>
          </div>

          <!-- Navigation -->
          <nav class="hidden space-x-2 md:flex">
            <a
              href="/admin/users"
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                currentPath === "/admin/users"
                  ? "bg-white/10 text-white"
                  : "text-gray-300 hover:bg-white/5 hover:text-white",
              ]}
            >
              ユーザー管理
            </a>
            <a
              href="/member/dashboard"
              class="rounded-md px-3 py-2 text-sm font-medium text-gray-300 transition-colors hover:bg-white/5 hover:text-white"
            >
              会員サイトに戻る
            </a>
          </nav>

          <!-- User Menu -->
          <div class="flex items-center space-x-4">
            <span class="hidden text-sm text-gray-300 sm:inline">
              {user?.email ?? ""}
            </span>
            <form method="POST" action={actions.auth.signOut}>
              <button
                type="submit"
                class="rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
              >
                サインアウト
              </button>
            </form>
          </div>
        </div>

        <!-- Mobile Navigation -->
        <nav class="space-y-1 pb-4 md:hidden">
          <a
            href="/admin/users"
            class:list={[
              "block rounded-md px-3 py-2 text-base font-medium transition-colors",
              currentPath === "/admin/users"
                ? "bg-white/10 text-white"
                : "text-gray-300 hover:bg-white/5 hover:text-white",
            ]}
          >
            ユーザー管理
          </a>
          <a
            href="/member/dashboard"
            class="block rounded-md px-3 py-2 text-base font-medium text-gray-300 transition-colors hover:bg-white/5 hover:text-white"
          >
            会員サイトに戻る
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 bg-gray-50">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 bg-white py-6">
      <div
        class="mx-auto max-w-7xl px-4 text-center text-sm text-gray-600 sm:px-6 lg:px-8"
      >
        &copy; 2026 会員サイトテンプレート. All rights reserved.
      </div>
    </footer>
  </div>
</Base>

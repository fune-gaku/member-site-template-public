{
  "name": "member-site-template",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && astro build && wrangler dev",
    "deploy": "wrangler types && astro build && wrangler deploy",
    "astro": "astro",
    "generate-types": "wrangler types",
    "cf-typegen": "wrangler types",
    "lint": "eslint . --max-warnings 84",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,vue,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,vue,md,json}\" --ignore-path .gitignore",
    "test": "VITEST=true vitest run",
    "test:watch": "VITEST=true vitest",
    "test:ui": "VITEST=true vitest --ui",
    "test:workers": "npm run build && vitest run --config vitest.workers.config.ts",
    "typecheck": "wrangler types && astro check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff --linked",
    "db:lint": "supabase db lint",
    "db:test": "supabase test db",
    "db:push:dry-run": "supabase db push --dry-run",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vue": "^6.0.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.2.1",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.34"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "vite": "^7",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^10.1.0",
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.4",
    "wrangler": "^4.84.0"
  }
}

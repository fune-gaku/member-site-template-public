# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
.dev.vars

# wrangler
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# worker configuration types
worker-configuration.d.ts

# test coverage
coverage
.vitest-cache

# Claude Code per-user local settings (do NOT commit)
.claude/settings.local.json

# Claude Code runtime lock (ScheduleWakeup 等で稼働中セッションが取得するロック、コミット対象外)
.claude/scheduled_tasks.lock

# Supabase CLI ローカル状態 (supabase init が supabase/.gitignore にも同じ記述を生成するが、
# ルートに防御的に重ねる: 誤って supabase/.gitignore を消してもコミットを防ぐ)
supabase/.temp/
supabase/.branches/

# Supabase Studio (http://127.0.0.1:54323) の SQL Editor が保存するクエリスニペット。
# 開発者ローカル環境固有 (.vscode/ 等と同じ位置づけ)。中身に test data やビジネス
# 文脈が紛れる可能性があるためコミット禁止。supabase/.gitignore にも同じ記述あり。
supabase/snippets/

# Design mock-up HTML / archives (Phase 1 design reference, kept locally only)
# 実装は src/ にあり、これらは参照用。コミットせずローカル保持のみ。
mocks/
mocks.zip

# /codex-cross-review の per-PR artifacts（Codex review / Claude evaluation / docs-check / 生 LOG）
# ワークスペース直下に置くことで VSCode 上の markdown リンクから 1 クリックで開ける。
.codex-review/
